{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "gcc-debug",
      "inherits": "linux",
      "displayName": "GCC Debug (host)",
      "description": "Default day-to-day build: host GCC with debug symbols and contract asserts enabled.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "gcc-release",
      "inherits": "linux",
      "displayName": "GCC Release (host)",
      "description": "Optimized host GCC build (asserts compiled out). Use for the bench/ timings.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "linux",
      "displayName": "Clang Debug (host)",
      "description": "Host Clang build with debug symbols; the second compiler for dual-compiler validation.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-release",
      "inherits": "linux",
      "displayName": "Clang Release (host)",
      "description": "Optimized host Clang build.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc",
      "inherits": "windows",
      "displayName": "MSVC (Windows x64, Visual Studio 2022)",
      "description": "Native Windows build via the Visual Studio 2022 generator (multi-config: the build/test presets select Debug or Release). CMake locates the toolchain itself. Requires CMake >= 4.0 on PATH; the CMake bundled with Visual Studio 2022 is 3.x.",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "msvc-ninja",
      "inherits": "windows",
      "displayName": "MSVC + Ninja Release (CI)",
      "description": "Windows MSVC build through Ninja. Requires the MSVC environment to be active (cl.exe on PATH + INCLUDE/LIB set); the CI job runs vcvars via msvc-dev-cmd.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded"
      }
    },
    {
      "name": "msvc-ninja-debug",
      "inherits": "msvc-ninja",
      "displayName": "MSVC + Ninja Debug (CI)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc-debug",     "configurePreset": "gcc-debug" },
    { "name": "gcc-release",   "configurePreset": "gcc-release" },
    { "name": "clang-debug",   "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "msvc-debug",    "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "msvc-release",  "configurePreset": "msvc", "configuration": "Release" },
    { "name": "msvc-ninja",    "configurePreset": "msvc-ninja" },
    { "name": "msvc-ninja-debug", "configurePreset": "msvc-ninja-debug" }
  ],
  "testPresets": [
    { "name": "gcc-debug",     "configurePreset": "gcc-debug",     "output": { "outputOnFailure": true } },
    { "name": "gcc-release",   "configurePreset": "gcc-release",   "output": { "outputOnFailure": true } },
    { "name": "clang-debug",   "configurePreset": "clang-debug",   "output": { "outputOnFailure": true } },
    { "name": "clang-release", "configurePreset": "clang-release", "output": { "outputOnFailure": true } },
    { "name": "msvc-debug",    "configurePreset": "msvc", "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "msvc-release",  "configurePreset": "msvc", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "msvc-ninja",    "configurePreset": "msvc-ninja",       "output": { "outputOnFailure": true } },
    { "name": "msvc-ninja-debug", "configurePreset": "msvc-ninja-debug", "output": { "outputOnFailure": true } }
  ]
}
